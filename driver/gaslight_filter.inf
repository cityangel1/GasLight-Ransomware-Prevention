;;;
;;; GasLight Ransomware Prevention Filter
;;;
;;; Standard minifilter INF, modeled on the WDK's own "Filter Driver"
;;; project template. Two things here NEED your attention before this is
;;; anything more than a local test-VM install:
;;;
;;;   1. Instance1.Altitude below (385100) is a PLACEHOLDER inside the
;;;      documented "FSFilter Activity Monitor" load-order group range
;;;      (roughly 360000-389999). Real minifilters must request an
;;;      official altitude assignment from Microsoft before shipping —
;;;      see https://learn.microsoft.com/windows-hardware/drivers/ifs/allocated-altitudes
;;;      A placeholder is fine for a local/test-signed development build,
;;;      not for anything distributed further.
;;;
;;;   2. CatalogFile / driver signing: this INF references a .cat file
;;;      that doesn't exist until you actually build and sign the driver.
;;;      For test-VM use: enable test signing (bcdedit /set testsigning on),
;;;      then self-sign with a test certificate as part of your build, or
;;;      load via `sc create` + `fltmc load` against an unsigned build
;;;      with signature enforcement disabled. Never do this on a machine
;;;      you don't consider disposable.

[Version]
Signature   = "$Windows NT$"
Class       = "ActivityMonitor"
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider    = %ManufacturerName%
DriverVer   =
CatalogFile = GasLightFilter.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir          = 12
MiniFilter.DriverFiles  = 12

[DefaultInstall]
OptionDesc  = %ServiceDescription%
CopyFiles   = MiniFilter.DriverFiles

[DefaultInstall.Services]
AddService  = %ServiceName%,,MiniFilter.Service

[DefaultUninstall]
DelFiles    = MiniFilter.DriverFiles

[DefaultUninstall.Services]
DelService  = %ServiceName%,0x200

[Standard.NT$ARCH$]

[MiniFilter.Service]
DisplayName     = %ServiceName%
Description     = %ServiceDescription%
ServiceBinary   = %12%\%DriverName%.sys
Dependencies    = "FltMgr"
ServiceType     = 2                            ; SERVICE_FILE_SYSTEM_DRIVER
StartType       = 3                            ; SERVICE_DEMAND_START — deliberately not auto-start
                                                ; until you've validated the build; flip to 0
                                                ; (SERVICE_BOOT_START) only once you trust it.
ErrorControl    = 1                            ; SERVICE_ERROR_NORMAL
LoadOrderGroup  = "FSFilter Activity Monitor"
AddReg          = MiniFilter.AddRegistry

[MiniFilter.AddRegistry]
HKR,,"DebugFlags",0x00010001,0x0
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\%Instance1.Name%","Altitude",0x00000000,%Instance1.Altitude%
HKR,"Instances\%Instance1.Name%","Flags",0x00010001,%Instance1.Flags%

[MiniFilter.DriverFiles]
%DriverName%.sys

[SourceDisksFiles]
GasLightFilter.sys = 1,,

[SourceDisksNames]
1 = %DiskId1%,,,

[Strings]
ManufacturerName      = "GasLight"
ServiceDescription    = "GasLight Ransomware Prevention Filter"
ServiceName            = "GasLightFilter"
DriverName             = "GasLightFilter"
DiskId1                = "GasLight Filter Driver Installation Disk"
Instance1.Name          = "GasLight Filter Instance"
Instance1.Altitude      = "385100"
Instance1.Flags         = 0x0
DefaultInstance          = "GasLight Filter Instance"
